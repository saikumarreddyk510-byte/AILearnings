# ============================================================
# AILearnings — .gitignore
# ============================================================

# ── Secrets & environment ──────────────────────────────────
.env
*.env
.env.*
!.env.example

# ── Python virtual environments ───────────────────────────
venv/
.venv/
**/venv/
**/.venv/
env/
ENV/

# ── Python cache & compiled ───────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ── Distribution / packaging ──────────────────────────────
build/
dist/
*.egg-info/
*.egg
MANIFEST
.eggs/

# ── Jupyter ───────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Testing & coverage ────────────────────────────────────
.pytest_cache/
**/.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
*.cover

# ── TypeScript / Node ─────────────────────────────────────
node_modules/
**/node_modules/
*.tsbuildinfo
.next/
.turbo/
out/

# ── OS generated ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
.idea/

# ── ML / AI artifacts ─────────────────────────────────────
*.pkl
*.h5
*.model
*.joblib
chroma_db/
**/chroma_db/

# ── Logs ──────────────────────────────────────────────────
*.log
logs/
